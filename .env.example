# Public base URL of the deployed site (used for canonical/Open Graph URLs).
NEXT_PUBLIC_SITE_URL=https://example.com

# E-Commerce API origin, WITHOUT /api/v1 (e.g. http://localhost:8000).
# Requests go to ${NEXT_PUBLIC_API_URL}/api/v1, user images to ${NEXT_PUBLIC_API_URL}/users/<file>.
NEXT_PUBLIC_API_URL=https://deepskyblue-hippopotamus-131894.hostingersite.com/

# Currency used to display prices (ISO 4217). Match the API CURRENCY setting (default AED).
NEXT_PUBLIC_CURRENCY=AED
